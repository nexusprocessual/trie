# Modelo de configuração. Copie para .env e preencha com os seus valores.
# NUNCA coloque chaves reais neste arquivo: ele vai para o Git. O .env fica fora (veja .gitignore).

# Supabase: Project Settings > API.
# A service_role key dá acesso total ao banco e só pode existir no servidor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# true para ler o IP real do visitante atrás de proxy/hospedagem (Render, Vercel, Cloudflare).
# Em proxy confiável use true; direto na internet, deixe false.
TRUST_PROXY=false

# Endereço que o servidor escuta. 0.0.0.0 aceita acessos externos (necessário em hospedagem).
HOST=127.0.0.1

# Porta local. Em hospedagem (Render, Railway), NÃO defina: a plataforma escolhe a porta.
PORT=4173

# true libera o /admin para qualquer pessoa com o link, sem senha.
# false (padrão) restringe o painel ao computador onde o servidor roda.
ADMIN_PUBLIC=false
